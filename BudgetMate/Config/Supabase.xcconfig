// Safe committed defaults keep clean checkouts buildable. Add real values to
// the ignored Supabase.local.xcconfig file; the optional include overrides
// these blanks without placing credentials in source control.
SUPABASE_PROJECT_URL =
SUPABASE_PUBLISHABLE_KEY =

// Gate C is deliberately inactive in every ordinary build. The three values
// must be set to YES together in Supabase.local.xcconfig only after the
// deployed server migration and RPCs have been verified.
BUDGETMATE_GATE_C_SERVER_READY = NO
BUDGETMATE_GATE_C_ENABLED = NO
BUDGETMATE_MONEY_SERVER_BRIDGE_ENABLED = NO

#include? "Supabase.local.xcconfig"
