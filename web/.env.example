VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Gate C is deliberately disabled in ordinary web builds. Set all three to YES
# only in the signed rollout build after the production RPCs are verified.
VITE_BUDGETMATE_GATE_C_SERVER_READY=NO
VITE_BUDGETMATE_GATE_C_ENABLED=NO
VITE_BUDGETMATE_MONEY_SERVER_BRIDGE_ENABLED=NO
